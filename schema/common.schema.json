{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyascope.local/schema/common.schema.json",
  "title": "VOYASCOPE 共通定義",
  "$comment": "RULES.md ルール3：事実項目はすべて出典必須。非公開の場合のみ undisclosed を使う。",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "string",
      "pattern": "^https://",
      "description": "出典URL。公式ソースを優先する。"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "bilingualName": {
      "type": "object",
      "required": ["ja", "en"],
      "additionalProperties": false,
      "properties": {
        "ja": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "fact": {
      "description": "出典付きの事実、または公表されていないことの明示",
      "oneOf": [
        {
          "type": "object",
          "required": ["value", "source"],
          "additionalProperties": false,
          "properties": {
            "value": {},
            "unit": { "type": "string" },
            "source": { "$ref": "#/$defs/source" },
            "as_of": { "$ref": "#/$defs/date" },
            "note": { "type": "string", "maxLength": 80 }
          }
        },
        {
          "type": "object",
          "required": ["undisclosed"],
          "additionalProperties": false,
          "properties": {
            "undisclosed": { "const": true }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/source" }
      }
    }
  }
}
