{
  "name": "voyascope-video",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "studio": "node scripts/music.mjs && remotion studio",
    "stills": "node scripts/stills.mjs",
    "render": "node scripts/music.mjs && remotion render VoyascopeTeaser out/voyascope-teaser.mp4 && remotion render VoyascopeTeaserSky out/voyascope-teaser-sky.mp4",
    "gif": "remotion render VoyascopeTeaserSky out/voyascope-preview-sky.gif --codec=gif --every-nth-frame=3 --scale=0.4",
    "typecheck": "tsc --noEmit -p .",
    "music": "node scripts/music.mjs",
    "render:vertical": "node scripts/music.mjs himawari && remotion render VoyascopeTeaserVertical out/voyascope-teaser-vertical.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.537",
    "@remotion/cli": "^4.0.537",
    "@remotion/google-fonts": "^4.0.537",
    "@remotion/renderer": "^4.0.537",
    "@remotion/transitions": "^4.0.537",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
