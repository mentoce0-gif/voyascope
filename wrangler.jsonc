{
  // VOYASCOPE を Cloudflare Workers の「静的アセット」として公開する（M9 ②・docs/m9-plan.md）。
  // サーバのコードはない。web/ のファイルをそのまま配る（静的なファイルの配信は無料・無制限）。
  // 公開は .github/workflows/deploy.yml（GitHub Actions から wrangler で）。キャッシュは web/_headers。
  "name": "voyascope",
  "compatibility_date": "2026-10-04",
  // 試作の部屋（/lab/）のパスワードと、アクセスを数える /api/hit だけの小さな Worker（2026-10-20・21 オーナー）。ほかの道は Worker を通らない
  "main": "src/lab-worker.js",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/lab", "/lab/*", "/api/*"]
  },
  // アクセスの数（src/count.js・2026-10-21 オーナー：案A）。1日ごと・ページ・来た元の種類・投稿の目印の回数だけを入れる
  // database_id は Cloudflare のダッシュボードで D1 のデータベース「voyascope-stats」を作ったときの ID（秘密ではない）
  "d1_databases": [
    { "binding": "STATS", "database_name": "voyascope-stats", "database_id": "TODO-オーナーが作った D1 の ID" }
  ],
  // 独自ドメイン（2026-10-04 オーナー決定）。Cloudflare が DNS と証明書を自動で用意する
  "routes": [
    { "pattern": "voyascope.org", "custom_domain": true }
  ]
}
